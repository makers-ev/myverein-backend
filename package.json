{
  "name": "myverein-backend",
  "author": "Luca-Pascal Junge",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "tsx src/db/migrate.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:club": "tsx src/scripts/seed-club.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "db:verify-counts": "tsx src/scripts/verify-counts.ts",
    "auth:generate": "better-auth generate --config src/auth/auth.ts --output src/auth/auth-schema.ts -y",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.25",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.8.0",
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.13",
    "nodemailer": "^10.0.9",
    "pdfkit": "^0.20.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "resend": "^6.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.17",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.12"
  }
}
