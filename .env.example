# Node environment. "production" enables Better Auth's secure-cookie
# defaults and disables verbose error output.
NODE_ENV=development

# Postgres connection string used by both Drizzle and Better Auth's adapter.
# When running via `docker compose up`, compose.yml overrides this for the
# backend service to point at the `db` service instead of localhost.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_backend_template

# Used by compose.yml's `db` service AND to build the DATABASE_URL above.
# Change the password before any non-local deployment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auth_backend_template

# Explicit pg pool bounds (src/db/client.ts). Unset falls back to sane
# defaults -- keep these bounded, an unbounded pool was a documented
# weakness of the old Keycloak backend template.
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# This server's own public URL. Passed to Better Auth as `baseURL` so it
# doesn't have to infer its own origin from the request -- matters once this
# sits behind a reverse proxy in production. Also decides two auth behaviors
# (see src/auth/auth.ts's `isHttpsDeployment`): whether session cookies are
# `Secure`-flagged, and whether Expo Go's dev-mode `exp://` origin is
# trusted. Keep this `http://` for local/LAN/Expo-Go testing -- a `https://`
# value here turns both of those into real-production behavior.
BACKEND_URL=http://localhost:3000

# Origin of the web client (Next.js). Added to Better Auth's trustedOrigins.
# Comma-separated to trust more than one at once -- e.g. both localhost and
# a LAN IP, so you don't have to edit this every time you switch between
# testing in a desktop browser and testing from a physical device on the
# same network.
WEB_ORIGIN=http://localhost:3001

# Registrable/base domain shared by this backend and its web clients when
# they run on different subdomains of it (e.g. api.example.com for this
# backend, app.example.com for the website, admin.example.com for the admin
# dashboard). Enables Better Auth's crossSubDomainCookies so the session
# cookie set here is visible to all of them, not just the exact host that
# issued it. Set to the REGISTRABLE domain only (example.com), never a
# specific subdomain (not api.example.com). Leave unset for a single
# -subdomain / same-origin deployment (the default local dev setup does not
# need this) -- only takes effect when BACKEND_URL above is https://, so it's
# harmless to leave set locally too.
COOKIE_DOMAIN=

# Deep-link scheme of the mobile client (Expo), e.g. myapp://. Added to
# Better Auth's trustedOrigins for the mobile OAuth/social-login callback.
MOBILE_SCHEME=myapp://

# Secret used by Better Auth to sign/encrypt cookies and tokens. Generate
# with `npx @better-auth/cli secret`.
BETTER_AUTH_SECRET=

# Port the Hono server listens on.
PORT=3000

# Host interface compose.yml binds the backend's port to. Loopback-only by
# default -- deliberately secure by default, not just when a deploy script
# happens to be the thing starting the container. Set to 0.0.0.0 only for
# LAN-based mobile-device testing (a phone hitting the host's LAN IP
# directly) -- an explicit opt-in, not the default.
BIND_HOST=127.0.0.1

# Resend API key for sending verification/reset-password emails (src/lib/email.ts).
# Optional in dev -- unset falls back to logging the email instead of sending it.
RESEND_API_KEY=

# "From" address for outgoing emails. Required once RESEND_API_KEY or
# SMTP_HOST is set.
EMAIL_FROM=

# SMTP relay for outgoing emails (alternative to Resend, e.g. your own mail
# server). Takes priority over RESEND_API_KEY when both are set.
SMTP_HOST=
SMTP_PORT=587
# "true" for port 465 (implicit TLS), "false" for 587/25 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Consumed only by `npm run seed:admin` (or `docker compose exec backend npm
# run seed:admin`) -- never read by the server itself, so these can be
# deleted from the environment again after the admin account is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Static bearer token for GET /internal/stats (src/routes/internal-stats.ts)
# -- aggregate counts only (users, active sessions, audit_log event
# breakdown), never raw rows. Unset means the endpoint always responds 503
# ("not configured"), not a silent 401 -- fails safe/closed by default.
# Generate any long random value, e.g. `openssl rand -hex 32`. Deliberately
# a separate, single-purpose token rather than reusing an admin session --
# a caller of this endpoint (e.g. a central fleet dashboard) has no user
# account on this backend at all.
INTERNAL_STATS_TOKEN=

# Recipient(s) of the "new club registration to review" e-mail sent when an
# applicant submits a Verein-gruenden request (POST /club-registrations/:id/submit).
# Comma-separated for several platform reviewers. Optional: unset only logs a
# warning, the submission itself is never affected.
CLUB_REVIEW_NOTIFY_EMAIL=

# Validity of a member invitation (POST /club-members/:id/invite) in days.
# Optional, default 14, clamped to 1-60.
# MEMBER_INVITE_TTL_DAYS=14

# --- Member CSV import/export (POST /club-members/import, GET /club-members/export) ---
# Maximum data rows per import file. Optional, default 2000, clamped to 1-20000.
# MEMBER_IMPORT_MAX_ROWS=2000
# Maximum import file size in bytes. Optional, default 1048576 (1 MiB), clamped to 1024-10485760.
# MEMBER_IMPORT_MAX_BYTES=1048576
# Per-user rate limit (requests/minute) shared by import-template, import and export. Optional, default 10.
# MEMBER_CSV_RATE_LIMIT_PER_MINUTE=10

# --- Media security layer (src/lib/media.ts, src/lib/media-url.ts) ---
# Validity of signed media URLs (GET /media/<key>?exp=&sig=) in seconds.
# Optional, default 1800, clamped to 30-86400.
# MEDIA_URL_TTL_SECONDS=1800

# HMAC key for signed media URLs. Optional: unset falls back to
# BETTER_AUTH_SECRET. Set a separate value to rotate media links independently
# of sessions (all issued links become invalid on change).
# MEDIA_URL_SECRET=

# Storage quota per club in bytes (live files in media_files). Optional,
# default 1073741824 (1 GiB). Exceeding it answers 422 QUOTA_EXCEEDED.
# MEDIA_QUOTA_BYTES_PER_CLUB=1073741824

# Unclaimed uploads (POST /media files no feature row attached): swept after
# this many hours (default 24), and capped per user (default 25 files / 50 MB).
# MEDIA_UNATTACHED_TTL_HOURS=24
# MEDIA_UNATTACHED_MAX_FILES_PER_USER=25
# MEDIA_UNATTACHED_MAX_BYTES_PER_USER=52428800

# Local-disk root for uploaded files (photos, club registration proofs).
# Optional: defaults to ./uploads; the Docker image sets /data/uploads.
# UPLOADS_DIR=./uploads

# --- Form builder (src/routes/form-submissions.ts) ---
# Per-user hourly limit of file uploads/removals into application drafts
# (POST/DELETE /form-submissions/:id/files). Optional, default 30.
# FORM_UPLOADS_PER_HOUR=30
# Per-user hourly limit of creating application drafts and of submitting them
# (separate buckets). Optional, default 20.
# FORM_SUBMISSIONS_PER_HOUR=20
